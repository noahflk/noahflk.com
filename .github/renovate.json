{
  "extends": ["config:base"],
  "stabilityDays": 7,
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "updateNotScheduled": true,
  "timezone": "Europe/Zurich",
  "schedule": ["before 5am on Monday"],
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "labels": ["dependencies"],
      "automerge": true
    },
    {
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "breaking"],
      "automerge": false
    },
    {
      "description": "@astrojs/sitemap 3.6.1+ reads routes from the astro:routes:resolved hook, which Astro 4.16.19 never emits, so astro build crashes with 'Cannot read properties of undefined (reading reduce)'. Keep 3.6.0 until the Astro upgrade lands, then remove this rule.",
      "matchPackageNames": ["@astrojs/sitemap"],
      "allowedVersions": "3.6.0"
    }
  ]
}
